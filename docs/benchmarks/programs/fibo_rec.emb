.constants:
    output_message = "Output: "
    error_message = "Please write a number!\n"

.code:
    func main(arity=0, locals=0):
        call ask_for_input
        call fib
        call write_output
        ret

    func ask_for_input(arity=0, locals=0):
    @user_input:
        input
        parse_int
        status_ok
        jmp_if_false error_handling
        ret

    @error_handling:
        ldc error_message
        print
        jmp user_input

    ; Computes fib(n) recursively.
    ;
    ; Argument:
    ;   arg0 = n
    ;
    ; Returns:
    ;   fib(n)
    func fib(arity=1, locals=0):
        geta 0
        ldc 2
        lt
        jmp_if_false recursive_case

        geta 0
        ret

    @recursive_case:
        geta 0
        ldc 1
        isub
        call fib

        geta 0
        ldc 2
        isub
        call fib

        iadd
        ret

    func write_output(arity=1, locals=0):
        ldc output_message
        geta 0
        i2s
        concat
        ldc "\n"
        concat
        print
        ret