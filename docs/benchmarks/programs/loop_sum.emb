.constants:
    output_message = "Output: "
    error_message = "Please write a number!\n"

.code:
    func main(arity=0, locals=0):
        call ask_for_input
        call loop_sum
        call write_output
        ret

    func ask_for_input(arity=0, locals=0):
    @user_input:
        input
        parse_int
        status_ok
        jmp_if_false error_handling
        ret

    @error_handling:
        ldc error_message
        print
        jmp user_input

    ; Computes:
    ;   sum = 0
    ;   i = 0
    ;   while i < n:
    ;       sum = sum + i
    ;       i = i + 1
    ;   return sum
    ;
    ; Argument:
    ;   arg0 = n
    ;
    ; Returns:
    ;   sum from 0 to n - 1
    func loop_sum(arity=1, locals=2):
        ldc 0
        setl 0      ; sum = 0

        ldc 0
        setl 1      ; i = 0

    @loop:
        getl 1      ; i
        geta 0      ; n
        lt          ; i < n
        jmp_if_false done

        getl 0      ; sum
        getl 1      ; i
        iadd
        setl 0      ; sum += i

        getl 1
        ldc 1
        iadd
        setl 1      ; i += 1

        jmp loop

    @done:
        getl 0
        ret

    func write_output(arity=1, locals=0):
        ldc output_message
        geta 0
        i2s
        concat
        ldc "\n"
        concat
        print
        ret