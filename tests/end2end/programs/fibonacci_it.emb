; Recursive Fibonacci example
;
; This program asks the user for a Fibonacci index,
; computes the result recursively, and prints it.
;
; Example:
;   Input: 6
;   Output: 8

.constants:
    output_message = "Output: "
    error_message = "Please write a number!\n"

.code:
    func main(arity=0, locals=0):
        ; Read a valid integer from the user.
        call ask_for_input

        ; Compute the Fibonacci number.
        call fib

        ; Print the result.
        call write_output

        ret

    ; Prompts the user for a Fibonacci index.
    ; Keeps asking until the input can be parsed as an integer.
    func ask_for_input(arity=0, locals=0):
    @user_input:
        ; Read input from stdin and try to convert it to an integer.
        input
        parse_int

        ; Check whether parse_int succeeded.
        status_ok
        jmp_if_false error_handling

        ; On success, the parsed integer remains on the stack.
        ret

    @error_handling:
        ; Print an error message and ask again.
        ldc error_message
        print
        jmp user_input
    ; Computes fib(n) iteratively.
    ;
    ; Argument:
    ;   arg0 = n
    ;
    ; Returns:
    ;   fib(n)
    func fib(arity=1, locals=3):
        ldc 0
        setl 0      ; a = 0

        ldc 1
        setl 1      ; b = 1

        ldc 0
        setl 2      ; i = 0

    @loop:
        getl 2      ; i
        geta 0      ; n
        lt          ; while i < n
        jmp_if_false done

        getl 0      ; a
        getl 1      ; b
        iadd        ; next = a + b

        getl 1      ; b
        setl 0      ; a = b

        setl 1      ; b = next

        getl 2
        ldc 1
        iadd
        setl 2      ; i += 1

        jmp loop

    @done:
        getl 0
        ret

    ; Prints the result in the format:
    ; Output: <value>
    func write_output(arity=1, locals=0):
        ldc output_message

        ; Convert the result integer to a string.
        geta 0
        i2s

        ; Build the output message.
        concat
        ldc "\n"
        concat

        print
        ret